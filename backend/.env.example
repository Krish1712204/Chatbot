# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by Git, so your real keys never get uploaded.

# ---------- AI provider ----------
# Which AI to use: "mock" (fake answers, free, no key needed),
# "openai" (OpenAI or any OpenAI-compatible API) or "anthropic" (Claude).
LLM_PROVIDER=mock

# ---------- OpenAI / OpenAI-compatible (used when LLM_PROVIDER=openai) ----------
# Your API key. For Ollama (runs on your own computer) any text works, e.g. "ollama".
OPENAI_API_KEY=
# Leave empty for OpenAI itself. Set it to use another service:
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=
# Model name for that service. Examples:
#   OpenAI: gpt-4o-mini   Groq: llama-3.3-70b-versatile
#   Gemini: gemini-2.5-flash   Ollama: llama3.2
OPENAI_MODEL=gpt-4o-mini

# ---------- Anthropic / Claude (used when LLM_PROVIDER=anthropic) ----------
# Your key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Claude model name. claude-opus-5-5 is the current default.
# The refusal fallback in app/llm.py works with Opus 5.5, Opus 5, Sonnet 5.5 and Fable models.
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Security ----------
# Secret used to sign login tokens (JWT). Use a long random string.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Database ----------
# Where data is stored. This creates a file chatbot.db in the backend folder.
DATABASE_URL=sqlite:///./chatbot.db

# ---------- Frontend ----------
# The website address allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Chat behaviour ----------
# Instructions given to the AI before every conversation.
SYSTEM_PROMPT=You are a helpful assistant. Answer clearly and use Markdown when it helps.
